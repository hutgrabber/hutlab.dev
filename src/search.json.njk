---
permalink: /search.json
eleventyExcludeFromCollections: true
---
[
{%- for post in collections.posts %}
  {
    "title": {{ post.data.title | dump | safe }},
    "url": {{ post.url | dump | safe }},
    "date": {{ post.date | readableDate | dump | safe }},
    "tags": {{ post.data.tags | displayTags | dump | safe }},
    "description": {{ (post.data.description or "") | dump | safe }},
    "text": {{ post.templateContent | squash | dump | safe }}
  }{% if not loop.last %},{% endif %}
{%- endfor %}
]
