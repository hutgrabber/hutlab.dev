---
layout: layouts/base.njk
permalink: /
---
<section class="hero" aria-label="Introduction">
  <div class="terminal">
    <div class="terminal-bar" aria-hidden="true">
      <span class="term-dot"></span><span class="term-dot"></span><span class="term-dot"></span>
      <span class="term-title">{{ site.author.handle }}@{{ site.domain }}:~</span>
    </div>
    <div class="terminal-body">
      <p><span class="prompt-glyph">$</span> whoami</p>
      <p class="term-out">{{ site.author.name }} — penetration tester, cybersecurity enthusiast, coffee snob.</p>
      <p><span class="prompt-glyph">$</span> cat mission.txt</p>
      <p class="term-out">All things cyber: tutorials, write-ups &amp; field notes from the lab.</p>
      <p><span class="prompt-glyph">$</span> ls ./posts --sort=date<span class="cursor" aria-hidden="true"></span></p>
    </div>
  </div>
</section>

<section class="search" aria-label="Search posts">
  <label class="search-row" for="search-input">
    <span class="prompt-glyph" aria-hidden="true">$</span>
    <span class="search-cmd" aria-hidden="true">grep -ri</span>
    <input id="search-input" type="search" placeholder='"query"' autocomplete="off"
           spellcheck="false" aria-label="Search posts">
    <span class="search-cmd" aria-hidden="true">./posts</span>
  </label>
  <p class="search-status" id="search-status" role="status" aria-live="polite" hidden></p>
</section>

<section aria-label="Posts">
  <ol class="post-list" id="search-results" hidden></ol>
  <ol class="post-list" id="post-list" reversed>
    {%- for post in collections.posts %}
    <li class="post-item">
      <div class="post-item-meta">
        <time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time>
        {%- for tag in post.data.tags | displayTags %}
        <a class="tag-chip" href="/tags/{{ tag }}/">#{{ tag }}</a>
        {%- endfor %}
      </div>
      <h2 class="post-item-title"><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
      {%- if post.data.description %}
      <p class="post-item-excerpt">{{ post.data.description }}</p>
      {%- endif %}
      <p class="post-item-more"><a href="{{ post.url }}" aria-label="Read {{ post.data.title }}">./read <span aria-hidden="true">→</span></a></p>
    </li>
    {%- endfor %}
  </ol>
</section>

<script src="/assets/js/search.js?v={{ buildId }}" defer></script>
