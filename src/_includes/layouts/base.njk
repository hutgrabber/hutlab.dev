<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if meta_title %}{{ meta_title }}{% elif title %}{{ title }} · {{ site.title }}{% else %}{{ site.title }} — all things cyber{% endif %}</title>
  <meta name="description" content="{{ description or site.description }}">
  <meta name="author" content="{{ site.author.name }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  {%- if noindex %}
  <meta name="robots" content="noindex">
  {%- endif %}
  {%- set is_post = "posts" in (tags or []) %}
  <meta property="og:type" content="{% if is_post %}article{% else %}website{% endif %}">
  <meta property="og:site_name" content="{{ site.title }}">
  <meta property="og:locale" content="en_US">
  <meta property="og:title" content="{{ meta_title or title or site.title }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  {%- if feature_image %}
  <meta property="og:image" content="{{ site.url }}{{ feature_image }}">
  <meta property="og:image:alt" content="{{ feature_image_caption or title }}">
  {%- else %}
  <meta property="og:image" content="{{ site.url }}/assets/images/og-card.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{{ site.title }} — all things cyber">
  {%- endif %}
  {%- if is_post %}
  <meta property="article:published_time" content="{{ page.date | isoDate }}">
  <meta property="article:author" content="{{ site.author.name }}">
  {%- for tag in tags | displayTags %}
  <meta property="article:tag" content="{{ tag }}">
  {%- endfor %}
  {%- endif %}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:site" content="{{ site.author.twitter }}">
  <meta name="twitter:creator" content="{{ site.author.twitter }}">
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/images/favicon-32.png">
  <link rel="icon" type="image/png" sizes="192x192" href="/assets/images/icon-192.png">
  <link rel="apple-touch-icon" href="/assets/images/apple-touch-icon.png">
  <link rel="alternate" type="application/rss+xml" title="{{ site.title }}" href="/feed.xml">
  <link rel="alternate" type="application/feed+json" title="{{ site.title }}" href="/feed.json">
  <script type="application/ld+json">
  {%- if is_post %}
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": {{ (title or site.title) | dump | safe }},
    "description": {{ (description or site.description) | dump | safe }},
    "url": "{{ site.url }}{{ page.url }}",
    "datePublished": "{{ page.date | isoDate }}",
    {%- if feature_image %}
    "image": "{{ site.url }}{{ feature_image }}",
    {%- endif %}
    "author": { "@type": "Person", "name": {{ site.author.name | dump | safe }}, "url": "{{ site.author.github }}" },
    "publisher": { "@type": "Person", "name": {{ site.author.name | dump | safe }} },
    "mainEntityOfPage": "{{ site.url }}{{ page.url }}"
  }
  {%- else %}
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": {{ site.title | dump | safe }},
    "description": {{ site.description | dump | safe }},
    "url": "{{ site.url }}/",
    "author": { "@type": "Person", "name": {{ site.author.name | dump | safe }}, "url": "{{ site.author.github }}" }
  }
  {%- endif %}
  </script>
  <link rel="preload" href="/assets/fonts/vt323-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/jetbrains-mono-var.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/style.css?v={{ buildId }}">
  <script>
    (function () {
      var t = localStorage.getItem("theme");
      if (t === "dark" || t === "light") document.documentElement.setAttribute("data-theme", t);
    })();
  </script>
</head>
<body>
  <a class="skip-link" href="#main">skip to content</a>
  <header class="site-header">
    <div class="wrap header-inner">
      <a class="brand" href="/" aria-label="{{ site.title }} home">
        <span class="brand-path">~/{{ site.title }}</span><span class="brand-prompt"> $</span><span class="cursor" aria-hidden="true"></span>
      </a>
      <nav class="site-nav" aria-label="Main">
        {%- for item in site.nav %}
        <a href="{{ item.url }}"{% if item.external %} target="_blank" rel="noopener"{% elif page.url == item.url %} aria-current="page"{% endif %}>./{{ item.label }}</a>
        {%- endfor %}
        <button id="theme-toggle" type="button" aria-label="Toggle color theme" title="Toggle theme">◐</button>
      </nav>
    </div>
  </header>

  <main id="main" class="wrap">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="wrap footer-inner">
      <p class="footer-line"><span class="prompt-glyph">$</span> echo "© {% year %} {{ site.author.name }}"</p>
      <p class="footer-links">
        <a href="/tags/">tags</a>
        <span aria-hidden="true">·</span>
        <a href="/feed/">rss</a>
        <span aria-hidden="true">·</span>
        <span class="footer-meta">built with eleventy, served by github pages</span>
      </p>
    </div>
  </footer>

  <script>
    // click-to-play for YouTube embed cards: swap the card for the player
    document.addEventListener("click", function (e) {
      var card = e.target.closest && e.target.closest(".embed-card--youtube[data-video-id]");
      if (!card) return;
      var id = card.getAttribute("data-video-id");
      if (!/^[\w-]{6,20}$/.test(id)) return;
      e.preventDefault();
      var wrap = document.createElement("div");
      wrap.className = "video-embed";
      var f = document.createElement("iframe");
      f.src = "https://www.youtube-nocookie.com/embed/" + id + "?autoplay=1";
      f.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture";
      f.allowFullscreen = true;
      var t = card.querySelector(".embed-title");
      f.title = (t && t.textContent) || "YouTube video";
      wrap.appendChild(f);
      card.replaceWith(wrap);
    });

    document.getElementById("theme-toggle").addEventListener("click", function () {
      var root = document.documentElement;
      var current = root.getAttribute("data-theme") || "dark";
      var next = current === "dark" ? "light" : "dark";
      root.setAttribute("data-theme", next);
      localStorage.setItem("theme", next);
    });
  </script>
</body>
</html>
