---
layout: layouts/base.njk
---
<article class="post">
  <header class="post-header">
    <p class="crumb"><span class="prompt-glyph">$</span> cat .{{ page.url }}index.md</p>
    <h1 class="post-title">{{ title }}</h1>
  </header>

  {%- if feature_image %}
  <figure class="feature-image">
    <img src="{{ feature_image }}" alt="{{ feature_image_caption or title }}">
    {%- if feature_image_caption %}
    <figcaption>{{ feature_image_caption }}</figcaption>
    {%- endif %}
  </figure>
  {%- endif %}

  <div class="prose">
    {{ content | safe }}
  </div>
</article>
