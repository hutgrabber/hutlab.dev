---
permalink: /feed.json
eleventyExcludeFromCollections: true
---
{
  "version": "https://jsonfeed.org/version/1.1",
  "title": {{ site.title | dump | safe }},
  "home_page_url": "{{ site.url }}/",
  "feed_url": "{{ site.url }}/feed.json",
  "description": {{ site.description | dump | safe }},
  "icon": "{{ site.url }}/assets/images/icon-192.png",
  "favicon": "{{ site.url }}/assets/images/favicon-32.png",
  "language": "en-US",
  "authors": [{ "name": {{ site.author.name | dump | safe }}, "url": "{{ site.author.github }}" }],
  "items": [
{%- for post in collections.posts %}
    {
      "id": "{{ site.url }}{{ post.url }}",
      "url": "{{ site.url }}{{ post.url }}",
      "title": {{ post.data.title | dump | safe }},
      "date_published": "{{ post.date | isoDate }}",
      {%- if post.data.description %}
      "summary": {{ post.data.description | dump | safe }},
      {%- endif %}
      {%- if post.data.feature_image %}
      "image": "{{ site.url }}{{ post.data.feature_image }}",
      {%- endif %}
      {%- if post.data.tags | displayTags | length %}
      "tags": {{ post.data.tags | displayTags | dump | safe }},
      {%- endif %}
      "content_html": {{ post.templateContent | absoluteUrls(site.url) | dump | safe }}
    }{% if not loop.last %},{% endif %}
{%- endfor %}
  ]
}
